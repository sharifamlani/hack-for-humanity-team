# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Gemini API / Gemma 4 ---
# Gates Challenge 2 (Best Open-Source AI Project) AND Challenge 3 (Best Use of Gemma 4).
# Get one at https://mlh.link/gemma
GEMINI_API_KEY=

# The model the PRODUCT uses. Must be Gemma 4 — it is the open-weight one.
# Verified reachable 2026-10-10: gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it

# Gemini models are CLOSED-weight and do NOT qualify for Challenge 2 or 3.
# Safe for unjudged side work only. Never let the judged path fall back to these.
# GOOGLE_MODEL=gemini-3.1-pro-preview
# GOOGLE_FLASH_MODEL=gemini-3.1-flash-preview

# --- Database / auth (only if the chosen idea needs persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Miami open data ---
# Census Geocoder, Miami-Dade ArcGIS, NWS, NHC, USGS, iNaturalist: all keyless.
# Census ACS needs a free key (returns HTTP 200 + an HTML error page without one):
# https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=
